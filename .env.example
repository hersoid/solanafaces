# ── Solanafaces at Solana Spaces — environment settings ──
# Copy these into Vercel → Project → Settings → Environment Variables.
# Never paste real keys into chat, email or code.

# Network: "devnet" for rehearsals, "mainnet-beta" for the event.
SOLANA_CLUSTER=devnet
# Optional: a dedicated RPC (Helius, Triton, QuickNode). Public RPCs are rate-limited.
RPC_URL=

# Dedicated minting wallet secret key (base58 string or the JSON number array a wallet exports).
# This wallet pays every mint and the Arweave storage. Keep ~1 SOL in it on mainnet.
MINTER_SECRET_KEY=

# Filled in after you press "Create collection" on /booth/setup.
COLLECTION_ADDRESS=

# Which engine mints: "metaplex" (direct, works on devnet + mainnet) or "mallow" (mainnet only).
MINT_DRIVER=metaplex
MALLOW_API_KEY=

# Royalty on secondary sales, in basis points (500 = 5%).
ROYALTY_BPS=500

# Herod Hersché drafts
ANTHROPIC_API_KEY=
HEROD_MODEL=claude-sonnet-5-5

# PIN for the booth app (/booth). Pick something long.
BOOTH_PIN=

# Visitor login (email + wallet). Create an app at dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=

# The public address of the site, used in the QR codes (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://solanafaces.vercel.app

# Added automatically when you connect Vercel Blob and Upstash Redis in the Vercel dashboard:
# BLOB_READ_WRITE_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
